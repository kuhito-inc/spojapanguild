{
  "name": "sjg-docs",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "docs:absolutize-links": "node scripts/absolutize-docs-links.mjs",
    "docs:english-anchors": "node scripts/english-anchor-docs.mjs",
    "docs:fix-relative-fragments": "node scripts/fix-relative-doc-fragments.mjs",
    "docs:infer-fence-lang": "node scripts/infer-code-fence-lang.mjs",
    "start": "next start",
    "test": "pnpm run types:check",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "js-yaml": "4.2.0",
      "postcss": "8.5.13"
    }
  },
  "dependencies": {
    "@orama/orama": "3.1.18",
    "@orama/tokenizers": "3.1.18",
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "16.8.7",
    "fumadocs-mdx": "14.3.2",
    "fumadocs-ui": "16.8.7",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "github-slugger": "^2.0.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  }
}
